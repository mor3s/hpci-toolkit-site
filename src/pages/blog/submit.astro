---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Write for the blog — HPCI Toolkit" description="Submit a post about what you're building with the toolkit.">
  <section class="container prose">
    <h1>Write for the blog</h1>
    <p class="lead">
      Building something with the toolkit, or have something to share? Write it up here.
      The body is Markdown — including images, which you embed by URL:
      <code>![description](https://…)</code>. Host the image somewhere public (your own
      site, or an image host) and paste the link. Your submission opens a pull request for
      review — once approved and published, it appears on the blog.
    </p>

    <form id="post-form" class="ritual-form">
      <label>Title<input name="title" required maxlength="120" /></label>
      <label>One-line description<input name="description" required maxlength="200" /></label>
      <div class="row">
        <label>Your name<input name="authorName" required /></label>
        <label>Tags (comma-separated)<input name="tags" placeholder="workshop, rituals" /></label>
      </div>
      <label>Post body (Markdown)
        <textarea name="content" rows="16" required placeholder="Write your post here. Markdown is supported — ## headings, *emphasis*, [links](…), and images by URL: ![alt](https://…)"></textarea>
      </label>
      <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="button" type="submit">Submit for review</button>
      <p id="post-form-status" class="form-status" role="status"></p>
    </form>
  </section>

  <script>
    const form = document.getElementById('post-form');
    const status = document.getElementById('post-form-status');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Submitting…';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/.netlify/functions/submit-post', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json();
        if (res.ok) {
          status.textContent = 'Thank you — your post has been submitted for review.';
          form.reset();
        } else {
          status.textContent = out.error || 'Something went wrong. Please check your entry.';
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
      }
    });
  </script>
</BaseLayout>