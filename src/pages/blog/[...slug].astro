---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${entry.data.title} — HPCI Toolkit`} description={entry.data.description}>
  <article class="container prose">
    <p class="ritual__back"><a href="/blog/">← Blog</a></p>
    <h1>{entry.data.title}</h1>
    <p class="post-meta">{fmt(entry.data.date)} · {entry.data.author}</p>
    <Content />
  </article>
</BaseLayout>